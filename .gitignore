# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

#md files
*.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# logs applicatifs (générés au runtime)
/logs/*.log

# typescript
*.tsbuildinfo
next-env.d.ts

# fichiers uploades (documents du personnel) : jamais dans le depot,
# ils vivent sur le disque persistant du serveur (UPLOAD_DIR)
/uploads/
