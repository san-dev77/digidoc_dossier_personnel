generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

// ============================================
// SYSTÈME DE RÔLES ET PERMISSIONS
// ============================================

// Table des rôles (personnalisables et modifiables)
model roles {
  id                     Int                      @id @default(autoincrement())
  code                   String                   @unique @db.VarChar(50) // Identifiant technique (ex: super_admin)
  nom                    String                   @unique @db.VarChar(100) // Nom affiché (modifiable)
  description            String?                  @db.Text
  couleur                String?                  @db.VarChar(20) // Pour l'UI (ex: "#3B82F6")
  is_system              Boolean                  @default(false) // true = non supprimable (ex: super_admin)
  created_at             DateTime                 @default(now()) @db.DateTime(6)
  updated_at             DateTime                 @default(now()) @db.DateTime(6)
  utilisateurs           utilisateurs[]
  role_permissions       role_permissions[]
  
  @@index([code])
  @@index([nom])
  @@index([is_system])
}

// Table des permissions (liste fixe de toutes les permissions possibles)
model permissions {
  id                       Int                        @id @default(autoincrement())
  code                     String                     @unique @db.VarChar(100) // Ex: "agents.create", "users.delete"
  nom_affichage            String                     @db.VarChar(200)
  description              String?                    @db.Text
  categorie                String                     @db.VarChar(50) // agents, rubriques, dossiers, utilisateurs, etc.
  created_at               DateTime                   @default(now()) @db.DateTime(6)
  role_permissions         role_permissions[]
  utilisateur_permissions  utilisateur_permissions[]
  
  @@index([code])
  @@index([categorie])
}

// Table de liaison : Permissions d'un rôle
model role_permissions {
  id             Int         @id @default(autoincrement())
  role_id        Int
  permission_id  Int
  created_at     DateTime    @default(now()) @db.DateTime(6)
  roles          roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permissions    permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  
  @@unique([role_id, permission_id])
  @@index([role_id])
  @@index([permission_id])
}

// Table des permissions individuelles (overrides)
// Permet d'ajouter ou retirer des permissions à un utilisateur spécifique
model utilisateur_permissions {
  id              Int          @id @default(autoincrement())
  utilisateur_id  Int
  permission_id   Int
  type            String       @db.VarChar(10) // "grant" = ajouter, "revoke" = retirer
  reason          String?      @db.Text // Pourquoi cet override
  granted_by      Int?         // ID de l'utilisateur qui a accordé cette permission
  created_at      DateTime     @default(now()) @db.DateTime(6)
  utilisateurs    utilisateurs @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  permissions     permissions  @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  
  @@unique([utilisateur_id, permission_id])
  @@index([utilisateur_id])
  @@index([permission_id])
  @@index([type])
}

// Table des utilisateurs qui peuvent se connecter à l'application
model utilisateurs {
  id                       Int                        @id @default(autoincrement())
  username                 String                     @unique @db.VarChar(50)
  email                    String                     @unique @db.VarChar(255)
  password                 String                     @db.VarChar(255)
  nom_complet              String                     @db.VarChar(255)
  role_id                  Int                        // FK vers roles
  agent_id                 Int?                       @unique // FK optionnel vers agents (un utilisateur peut être aussi un agent)
  statut                   String                     @default("actif") @db.VarChar(20) // actif, inactif, suspendu
  avatar                   String?                    @db.VarChar(500)
  telephone                String?                    @db.VarChar(50)
  departement              String?                    @db.VarChar(100)
  derniere_connexion       DateTime?                  @db.DateTime(6)
  nombre_connexions        Int                        @default(0)
  created_at               DateTime                   @default(now()) @db.DateTime(6)
  updated_at               DateTime                   @default(now()) @db.DateTime(6)
  created_by               Int?                       // ID de l'utilisateur qui a créé ce compte
  roles                    roles                      @relation(fields: [role_id], references: [id], onDelete: Restrict)
  agents                   agents?                    @relation(fields: [agent_id], references: [id], onDelete: SetNull)
  audit_logs               audit_logs[]
  utilisateur_permissions  utilisateur_permissions[]  // Permissions individuelles
  connexion_logs           connexion_logs[]

  @@index([username])
  @@index([email])
  @@index([role_id])
  @@index([agent_id])
  @@index([statut])
}

// Historique des connexions (une ligne par connexion réussie)
model connexion_logs {
  id             Int          @id @default(autoincrement())
  utilisateur_id Int
  connected_at   DateTime     @default(now()) @db.DateTime(6)
  utilisateurs   utilisateurs @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@index([utilisateur_id])
  @@index([connected_at])
}

// Table pour l'audit des actions (traçabilité)
model audit_logs {
  id             Int          @id @default(autoincrement())
  utilisateur_id Int
  action         String       @db.VarChar(100) // create, update, delete, view
  entity_type    String       @db.VarChar(50)  // agent, rubrique, piece, utilisateur, role
  entity_id      Int?
  description    String?      @db.Text
  ip_address     String?      @db.VarChar(50)
  user_agent     String?      @db.VarChar(500)
  created_at     DateTime     @default(now()) @db.DateTime(6)
  utilisateurs   utilisateurs @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  
  @@index([utilisateur_id])
  @@index([action])
  @@index([entity_type])
  @@index([created_at])
}

model agent_rubriques {
  id          Int       @id @default(autoincrement())
  agent_id    Int
  rubrique_id Int
  agents      agents    @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rubriques   rubriques @relation(fields: [rubrique_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model agent_dossiers {
  id              Int           @id @default(autoincrement())
  agent_id        Int
  rubrique_id     Int
  sous_dossier_id Int
  created_at      DateTime?     @default(now()) @db.DateTime(6)
  agents          agents        @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rubriques       rubriques     @relation(fields: [rubrique_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sous_dossiers   sous_dossiers @relation(fields: [sous_dossier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  meta_values         meta_values[]
  piece_file           piece_file[]
  meta_credit_values          meta_credit_values[]
  credit_files                 credit_files[]
  credit_dossier_entries       credit_dossier_entries[]

  @@unique([agent_id, rubrique_id, sous_dossier_id])
  @@index([agent_id])
  @@index([rubrique_id])
  @@index([sous_dossier_id])
}

model agents {
  id                     Int               @id @default(autoincrement())
  matricule              String            @unique @db.VarChar(50)
  nom_complet            String            @db.VarChar(255)
  fonction               String?           @db.VarChar(255)
  date_naissance         DateTime?         @db.Date
  lieu_naissance         String?           @db.VarChar(255)
  sexe                   String?           @db.VarChar(255)
  situation_matrimoniale String?           @db.VarChar(50)
  adresse                String?
  telephone              String?           @db.VarChar(50)
  email                  String?           @db.VarChar(255)
  statut                 String            @default("actif") @db.VarChar(20) // actif, inactif, retraite
  photo                  String?           @db.VarChar(500)
  created_at             DateTime?         @default(now()) @db.DateTime(6)
  updated_at             DateTime?         @default(now()) @db.DateTime(6)
  agent_rubriques        agent_rubriques[]
  agent_dossiers         agent_dossiers[]
  fiabilisations         fiabilisations[]
  notifications          notifications[]
  pieces_check           pieces_check[]
  utilisateur            utilisateurs?     // Compte utilisateur associé (optionnel)
  
  @@index([matricule])
  @@index([nom_complet])
  @@index([statut])
}

model fiabilisations {
  id          Int       @id @default(autoincrement())
  agent_id    Int
  piece_nom   String    @db.VarChar(255)
  statut      String    @db.VarChar(255)
  date_update DateTime? @default(now()) @db.DateTime(6)
  agents      agents    @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model notifications {
  id         Int       @id @default(autoincrement())
  agent_id   Int
  message    String
  type_notif String    @db.VarChar(255)
  date_envoi DateTime? @default(now()) @db.DateTime(6)
  lu         Boolean?  @default(false)
  agents     agents    @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model rubriques {
  id                     Int                      @id @default(autoincrement())
  nom                    String                   @db.VarChar(255)
  description            String?
  type                   String                   @default("personnel") @db.VarChar(20) // "personnel" ou "credit"
  agent_rubriques        agent_rubriques[]
  agent_dossiers         agent_dossiers[]
  sous_dossiers          sous_dossiers[]
  sous_dossier_positions sous_dossier_positions[]

  @@index([type])
}

model sous_dossiers {
  id              Int                     @id @default(autoincrement())
  rubrique_id     Int
  titre           String                  @db.VarChar(255)
  description     String?
  statut          String                  @default("ouvert") @db.VarChar(50)
  created_at      DateTime?               @default(now()) @db.DateTime(6)
  updated_at      DateTime?               @default(now()) @db.DateTime(6)
  agent_dossiers  agent_dossiers[]
  pieces          pieces[]
  metadata_credit metadata_credit[]
  rubriques       rubriques               @relation(fields: [rubrique_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  position        sous_dossier_positions?
  piece_positions piece_positions[]
}

model sous_dossier_positions {
  id              Int           @id @default(autoincrement())
  rubrique_id     Int
  sous_dossier_id Int           @unique
  position        Int           @default(0)
  created_at      DateTime?     @default(now()) @db.DateTime(6)
  updated_at      DateTime?     @default(now()) @db.DateTime(6)
  sous_dossiers   sous_dossiers @relation(fields: [sous_dossier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rubriques       rubriques     @relation(fields: [rubrique_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([rubrique_id, sous_dossier_id])
  @@index([rubrique_id])
  @@index([sous_dossier_id])
}

model pieces {
  id              Int              @id @default(autoincrement())
  sous_dossier_id Int
  nom             String           @db.VarChar(255)
  description     String?
  created_at      DateTime?        @default(now()) @db.DateTime(6)
  has_meta        Boolean?         @default(false)
  updated_at      DateTime?        @default(now()) @db.DateTime(6)
  metadata_model  metadata_model[]
  pieces_check    pieces_check[]
  piece_file      piece_file[]
  sous_dossiers   sous_dossiers    @relation(fields: [sous_dossier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  position        piece_positions?
}

model piece_positions {
  id              Int           @id @default(autoincrement())
  sous_dossier_id Int
  piece_id        Int           @unique
  position        Int           @default(0)
  created_at      DateTime?     @default(now()) @db.DateTime(6)
  updated_at      DateTime?     @default(now()) @db.DateTime(6)
  pieces          pieces        @relation(fields: [piece_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sous_dossiers   sous_dossiers @relation(fields: [sous_dossier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sous_dossier_id, piece_id])
  @@index([sous_dossier_id])
  @@index([piece_id])
}

model metadata_model {
  id          Int           @id @default(autoincrement())
  piece_id    Int
  obligatoire Boolean?      @default(false)
  created_at  DateTime?     @default(now()) @db.DateTime(6)
  description String?
  libelle     String        @db.VarChar(255)
  type        String        @db.VarChar(50)
  updated_at  DateTime?     @default(now()) @db.DateTime(6)
  pieces      pieces        @relation(fields: [piece_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  meta_values meta_values[]
}

model pieces_check {
  id         Int      @id @default(autoincrement())
  piece_id   Int
  disponible Boolean
  date_check DateTime @default(now()) @db.DateTime(6)
  agent_id   Int
  pieces     pieces   @relation(fields: [piece_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agents     agents   @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model piece_file {
  id               Int             @id @default(autoincrement())
  id_piece         Int
  agent_dossier_id Int?
  file_path        String
  created_at       DateTime        @default(now()) @db.DateTime(6)
  pieces           pieces          @relation(fields: [id_piece], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agent_dossiers   agent_dossiers? @relation(fields: [agent_dossier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([agent_dossier_id])
}

model meta_values {
  id               Int             @id @default(autoincrement())
  meta_model_id    Int
  agent_dossier_id Int?
  valeur           String
  created_at       DateTime        @default(now()) @db.DateTime(6)
  metadata_model   metadata_model  @relation(fields: [meta_model_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agent_dossiers   agent_dossiers? @relation(fields: [agent_dossier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([agent_dossier_id])
}

model metadata_credit {
  id                 Int                  @id @default(autoincrement())
  sous_dossier_id    Int
  nom_meta           String               @db.VarChar(255)
  type_meta          String               @db.VarChar(50)
  obligatoire        Boolean              @default(false)
  created_at         DateTime             @default(now()) @db.DateTime(6)
  sous_dossiers      sous_dossiers        @relation(fields: [sous_dossier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  meta_credit_values meta_credit_values[]
}

model meta_credit_values {
  id                 Int             @id @default(autoincrement())
  metadata_credit_id Int
  agent_dossier_id   Int?
  entry_id           Int?
  valeur             String          @db.Text
  created_at         DateTime        @default(now()) @db.DateTime(6)
  updated_at         DateTime?       @default(now()) @db.DateTime(6)
  metadata_credit    metadata_credit @relation(fields: [metadata_credit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agent_dossiers     agent_dossiers? @relation(fields: [agent_dossier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  credit_dossier_entries credit_dossier_entries? @relation(fields: [entry_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([agent_dossier_id])
  @@index([entry_id])
}

model credit_files {
  id               Int             @id @default(autoincrement())
  agent_dossier_id Int
  entry_id         Int?
  file_path        String          @db.VarChar(500)
  file_name        String          @db.VarChar(255)
  original_name    String          @db.VarChar(255)
  mime_type        String          @db.VarChar(100)
  file_size        Int
  thumbnail_path   String?         @db.VarChar(500)
  created_at       DateTime        @default(now()) @db.DateTime(6)
  agent_dossiers   agent_dossiers  @relation(fields: [agent_dossier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  credit_dossier_entries credit_dossier_entries? @relation(fields: [entry_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([agent_dossier_id])
  @@index([entry_id])
}

model credit_dossier_entries {
  id               Int                @id @default(autoincrement())
  agent_dossier_id Int
  label            String?            @db.VarChar(255)
  created_at       DateTime           @default(now()) @db.DateTime(6)
  updated_at       DateTime?          @default(now()) @db.DateTime(6)
  agent_dossiers   agent_dossiers     @relation(fields: [agent_dossier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  meta_credit_values meta_credit_values[]
  credit_files       credit_files[]

  @@index([agent_dossier_id])
}
